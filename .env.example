# ── 텔레그램 ──────────────────────────────────────────────────────────────
# @BotFather 에게 /newbot → 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 내 계정의 chat id. 봇에게 아무 메시지나 한 번 보낸 뒤:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# 응답의 result[0].message.chat.id 값
TELEGRAM_CHAT_ID=

# ── Upstash Redis (클릭 로그 · 레이트리밋) ────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 이메일 백업 (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
# 알림 받을 내 이메일. 도메인 인증 전에는 Resend 가입 계정과 같아야 발송됨
NOTIFY_EMAIL_TO=
# 도메인 인증 전에는 이 값을 그대로 둘 것
RESEND_FROM="onboarding@resend.dev"

# ── 접근 제어 ─────────────────────────────────────────────────────────────
# 그 애에게 줄 URL 경로: https://<도메인>/w/<SECRET_SLUG>
# 생성: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
SECRET_SLUG=
# /api/admin/status 보호용
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=

# ── 사이트 ────────────────────────────────────────────────────────────────
# 알림 메일에 들어갈 주소. 예: https://xxx.vercel.app
NEXT_PUBLIC_SITE_URL=
