# ── 카카오 ────────────────────────────────────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (기본 '사용함')
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 등록한 값과 문자 단위로 동일해야 함
# 로컬: http://localhost:3000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=

# ── Upstash Redis (토큰 · 클릭 로그 저장) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 이메일 백업 (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
# 알림 받을 내 이메일. 도메인 인증 전에는 Resend 가입 계정과 같아야 발송됨
NOTIFY_EMAIL_TO=
# 도메인 인증 전에는 이 값을 그대로 둘 것
RESEND_FROM="onboarding@resend.dev"

# ── 접근 제어 ─────────────────────────────────────────────────────────────
# 그 애에게 줄 URL 경로: https://<도메인>/w/<SECRET_SLUG>
# 생성: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
SECRET_SLUG=
# /api/auth/kakao/start, /api/admin/status 보호용
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=
# Vercel이 프로덕션에 자동 주입. 로컬 크론 테스트용으로만 직접 채우면 됨
CRON_SECRET=

# ── 사이트 ────────────────────────────────────────────────────────────────
# 카카오 메시지의 링크에 쓰임. 예: https://xxx.vercel.app
NEXT_PUBLIC_SITE_URL=
